{
  "schemaVersion": 11,
  "type": "default",
  "id": "form-complement-information",
  "components": [
    {
      "type": "text",
      "id": "form-complement-information-title",
      "text": "# Complément d’information"
    },
    {
      "label": "Informations manquantes détectées",
      "type": "textarea",
      "id": "form-complement-information-missing_information_text",
      "key": "missing_information_text",
      "readonly": true
    },
    {
      "label": "Demande envoyée au client",
      "type": "textarea",
      "id": "form-complement-information-customer_message",
      "key": "customer_message",
      "readonly": true
    },
    {
      "label": "Réponse / informations complémentaires du client",
      "type": "textarea",
      "id": "form-complement-information-additional_information",
      "key": "additional_information",
      "validate": {
        "required": true
      }
    },
    {
      "label": "Précisions sur le problème ou l’article",
      "type": "textarea",
      "id": "form-complement-information-description",
      "key": "description"
    },
    {
      "label": "Article porté (hors essayage)",
      "type": "select",
      "id": "form-complement-information-item_worn",
      "key": "item_worn",
      "values": [
        {
          "label": "Oui",
          "value": "yes"
        },
        {
          "label": "Non",
          "value": "no"
        },
        {
          "label": "Je ne sais pas",
          "value": "unknown"
        }
      ]
    },
    {
      "label": "Article lavé",
      "type": "select",
      "id": "form-complement-information-item_washed",
      "key": "item_washed",
      "values": [
        {
          "label": "Oui",
          "value": "yes"
        },
        {
          "label": "Non",
          "value": "no"
        },
        {
          "label": "Je ne sais pas",
          "value": "unknown"
        }
      ]
    },
    {
      "label": "Article modifié",
      "type": "select",
      "id": "form-complement-information-item_modified",
      "key": "item_modified",
      "values": [
        {
          "label": "Oui",
          "value": "yes"
        },
        {
          "label": "Non",
          "value": "no"
        },
        {
          "label": "Je ne sais pas",
          "value": "unknown"
        }
      ]
    },
    {
      "label": "Étiquettes d’origine attachées",
      "type": "select",
      "id": "form-complement-information-original_tags_attached",
      "key": "original_tags_attached",
      "values": [
        {
          "label": "Oui",
          "value": "yes"
        },
        {
          "label": "Non",
          "value": "no"
        },
        {
          "label": "Je ne sais pas",
          "value": "unknown"
        }
      ]
    },
    {
      "label": "Article endommagé selon le client",
      "type": "select",
      "id": "form-complement-information-item_damaged",
      "key": "item_damaged",
      "values": [
        {
          "label": "Oui",
          "value": "yes"
        },
        {
          "label": "Non",
          "value": "no"
        },
        {
          "label": "Je ne sais pas",
          "value": "unknown"
        }
      ]
    },
    {
      "label": "Référence de photo fictive",
      "type": "textfield",
      "id": "form-complement-information-evidence_reference",
      "key": "evidence_reference"
    }
  ],
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.52.0"
  }
}
{
  "schemaVersion": 11,
  "type": "default",
  "id": "form-inspection-produit",
  "components": [
    {
      "type": "text",
      "id": "form-inspection-produit-title",
      "text": "# Inspection du vêtement"
    },
    {
      "label": "Article attendu",
      "type": "textfield",
      "id": "form-inspection-produit-product_name",
      "key": "product_name",
      "readonly": true
    },
    {
      "label": "Motif déclaré",
      "type": "textfield",
      "id": "form-inspection-produit-return_reason",
      "key": "return_reason",
      "readonly": true
    },
    {
      "label": "Description du client",
      "type": "textarea",
      "id": "form-inspection-produit-description",
      "key": "description",
      "readonly": true
    },
    {
      "label": "La référence correspond à l’article attendu",
      "type": "checkbox",
      "id": "form-inspection-produit-inspection_reference_match",
      "key": "inspection_reference_match",
      "defaultValue": false
    },
    {
      "label": "La quantité reçue correspond",
      "type": "checkbox",
      "id": "form-inspection-produit-inspection_quantity_match",
      "key": "inspection_quantity_match",
      "defaultValue": false
    },
    {
      "label": "État constaté",
      "type": "select",
      "id": "form-inspection-produit-inspection_condition",
      "key": "inspection_condition",
      "values": [
        {
          "label": "Neuf",
          "value": "new"
        },
        {
          "label": "Essayé uniquement",
          "value": "tried_on"
        },
        {
          "label": "Porté",
          "value": "worn"
        },
        {
          "label": "Lavé",
          "value": "washed"
        },
        {
          "label": "Modifié",
          "value": "modified"
        },
        {
          "label": "Endommagé",
          "value": "damaged"
        },
        {
          "label": "Défectueux",
          "value": "defective"
        }
      ],
      "validate": {
        "required": true
      }
    },
    {
      "label": "Étiquettes d’origine attachées",
      "type": "select",
      "id": "form-inspection-produit-original_tags_attached",
      "key": "original_tags_attached",
      "values": [
        {
          "label": "Oui",
          "value": "yes"
        },
        {
          "label": "Non",
          "value": "no"
        },
        {
          "label": "Je ne sais pas",
          "value": "unknown"
        }
      ]
    },
    {
      "label": "Article endommagé",
      "type": "select",
      "id": "form-inspection-produit-item_damaged",
      "key": "item_damaged",
      "values": [
        {
          "label": "Oui",
          "value": "yes"
        },
        {
          "label": "Non",
          "value": "no"
        },
        {
          "label": "Je ne sais pas",
          "value": "unknown"
        }
      ]
    },
    {
      "label": "Défaut déclaré confirmé",
      "type": "select",
      "id": "form-inspection-produit-defect_confirmed",
      "key": "defect_confirmed",
      "values": [
        {
          "label": "Oui",
          "value": "yes"
        },
        {
          "label": "Non",
          "value": "no"
        },
        {
          "label": "Je ne sais pas",
          "value": "unknown"
        }
      ]
    },
    {
      "label": "Différences constatées",
      "type": "textarea",
      "id": "form-inspection-produit-inspection_differences",
      "key": "inspection_differences"
    },
    {
      "label": "Résultat de l’inspection",
      "type": "select",
      "id": "form-inspection-produit-inspection_result",
      "key": "inspection_result",
      "values": [
        {
          "label": "Conforme à la demande",
          "value": "conforming"
        },
        {
          "label": "Non conforme",
          "value": "non_conforming"
        }
      ],
      "validate": {
        "required": true
      }
    },
    {
      "label": "Contrôle qualité validé",
      "type": "checkbox",
      "id": "form-inspection-produit-qualityCheckPassed",
      "key": "qualityCheckPassed",
      "description": "Cette valeur alimente la passerelle BPMN.",
      "defaultValue": false
    }
  ],
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.52.0"
  }
}

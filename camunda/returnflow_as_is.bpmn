<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_returnflow_as_is" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="returnflow_as_is" name="ReturnFlow AI - AS-IS" isExecutable="false">
    <bpmn:startEvent id="Start_Demande" name="Demande reçue">
      <bpmn:outgoing>Flow_Start_Demande_Task_Lire</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="Task_Lire" name="Lire la demande">
      <bpmn:incoming>Flow_Start_Demande_Task_Lire</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_Lire_Task_Recherche</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_Recherche" name="Rechercher la commande">
      <bpmn:incoming>Flow_Task_Lire_Task_Recherche</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_Recherche_Task_Verif</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_Verif" name="Vérifier les informations et les règles">
      <bpmn:incoming>Flow_Task_Recherche_Task_Verif</bpmn:incoming>
      <bpmn:incoming>Flow_Task_Echange_Task_Verif</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_Verif_GW_Complete</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="GW_Complete" name="Informations complètes ?" default="Flow_GW_Complete_Task_Echange">
      <bpmn:incoming>Flow_Task_Verif_GW_Complete</bpmn:incoming>
      <bpmn:outgoing>Flow_GW_Complete_Task_Autor</bpmn:outgoing>
      <bpmn:outgoing>Flow_GW_Complete_Task_Echange</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_Echange" name="Échanger avec le client">
      <bpmn:incoming>Flow_GW_Complete_Task_Echange</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_Echange_Task_Verif</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_Autor" name="Autoriser ou refuser le retour">
      <bpmn:incoming>Flow_GW_Complete_Task_Autor</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_Autor_GW_Autorise</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="GW_Autorise" name="Retour autorisé ?" default="Flow_GW_Autorise_Task_Refus">
      <bpmn:incoming>Flow_Task_Autor_GW_Autorise</bpmn:incoming>
      <bpmn:outgoing>Flow_GW_Autorise_Task_Instructions</bpmn:outgoing>
      <bpmn:outgoing>Flow_GW_Autorise_Task_Refus</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_Refus" name="Enregistrer le refus">
      <bpmn:incoming>Flow_GW_Autorise_Task_Refus</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_Refus_GW_Fusion</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_Instructions" name="Envoyer les instructions de retour">
      <bpmn:incoming>Flow_GW_Autorise_Task_Instructions</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_Instructions_Task_Reception</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_Reception" name="Réceptionner le produit">
      <bpmn:incoming>Flow_Task_Instructions_Task_Reception</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_Reception_Task_Inspection</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_Inspection" name="Inspecter le produit">
      <bpmn:incoming>Flow_Task_Reception_Task_Inspection</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_Inspection_Task_Decision</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_Decision" name="Décider de la résolution finale">
      <bpmn:incoming>Flow_Task_Inspection_Task_Decision</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_Decision_Task_Execution</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_Execution" name="Exécuter la résolution">
      <bpmn:incoming>Flow_Task_Decision_Task_Execution</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_Execution_GW_Fusion</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="GW_Fusion">
      <bpmn:incoming>Flow_Task_Refus_GW_Fusion</bpmn:incoming>
      <bpmn:incoming>Flow_Task_Execution_GW_Fusion</bpmn:incoming>
      <bpmn:outgoing>Flow_GW_Fusion_Task_Notifier</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_Notifier" name="Notifier le client">
      <bpmn:incoming>Flow_GW_Fusion_Task_Notifier</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_Notifier_Task_Cloture</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_Cloture" name="Clôturer le dossier">
      <bpmn:incoming>Flow_Task_Notifier_Task_Cloture</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_Cloture_End_Termine</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="End_Termine" name="Dossier terminé">
      <bpmn:incoming>Flow_Task_Cloture_End_Termine</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Demande_Task_Lire" sourceRef="Start_Demande" targetRef="Task_Lire" />
    <bpmn:sequenceFlow id="Flow_Task_Lire_Task_Recherche" sourceRef="Task_Lire" targetRef="Task_Recherche" />
    <bpmn:sequenceFlow id="Flow_Task_Recherche_Task_Verif" sourceRef="Task_Recherche" targetRef="Task_Verif" />
    <bpmn:sequenceFlow id="Flow_Task_Verif_GW_Complete" sourceRef="Task_Verif" targetRef="GW_Complete" />
    <bpmn:sequenceFlow id="Flow_GW_Complete_Task_Autor" name="Oui" sourceRef="GW_Complete" targetRef="Task_Autor">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=complete = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_GW_Complete_Task_Echange" name="Non" sourceRef="GW_Complete" targetRef="Task_Echange" />
    <bpmn:sequenceFlow id="Flow_Task_Echange_Task_Verif" sourceRef="Task_Echange" targetRef="Task_Verif" />
    <bpmn:sequenceFlow id="Flow_Task_Autor_GW_Autorise" sourceRef="Task_Autor" targetRef="GW_Autorise" />
    <bpmn:sequenceFlow id="Flow_GW_Autorise_Task_Instructions" name="Oui" sourceRef="GW_Autorise" targetRef="Task_Instructions">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=authorized = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_GW_Autorise_Task_Refus" name="Non" sourceRef="GW_Autorise" targetRef="Task_Refus" />
    <bpmn:sequenceFlow id="Flow_Task_Refus_GW_Fusion" sourceRef="Task_Refus" targetRef="GW_Fusion" />
    <bpmn:sequenceFlow id="Flow_Task_Instructions_Task_Reception" sourceRef="Task_Instructions" targetRef="Task_Reception" />
    <bpmn:sequenceFlow id="Flow_Task_Reception_Task_Inspection" sourceRef="Task_Reception" targetRef="Task_Inspection" />
    <bpmn:sequenceFlow id="Flow_Task_Inspection_Task_Decision" sourceRef="Task_Inspection" targetRef="Task_Decision" />
    <bpmn:sequenceFlow id="Flow_Task_Decision_Task_Execution" sourceRef="Task_Decision" targetRef="Task_Execution" />
    <bpmn:sequenceFlow id="Flow_Task_Execution_GW_Fusion" sourceRef="Task_Execution" targetRef="GW_Fusion" />
    <bpmn:sequenceFlow id="Flow_GW_Fusion_Task_Notifier" sourceRef="GW_Fusion" targetRef="Task_Notifier" />
    <bpmn:sequenceFlow id="Flow_Task_Notifier_Task_Cloture" sourceRef="Task_Notifier" targetRef="Task_Cloture" />
    <bpmn:sequenceFlow id="Flow_Task_Cloture_End_Termine" sourceRef="Task_Cloture" targetRef="End_Termine" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="returnflow_as_is">
      <bpmndi:BPMNShape id="Start_Demande_di" bpmnElement="Start_Demande">

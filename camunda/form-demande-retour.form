{
  "schemaVersion": 11,
  "type": "default",
  "id": "form-demande-retour",
  "components": [
    {
      "type": "text",
      "id": "form-demande-retour-title",
      "text": "# Demande de retour — vêtements"
    },
    {
      "type": "text",
      "id": "form-demande-retour-help",
      "text": "Cas académique inspiré des politiques publiques SHEIN Maroc. Utilisez uniquement des données fictives."
    },
    {
      "label": "Numéro de commande",
      "type": "textfield",
      "id": "form-demande-retour-order_id",
      "key": "order_id",
      "description": "Exemple : CMD-1001",
      "validate": {
        "required": true
      }
    },
    {
      "label": "Identifiant de la ligne d’article",
      "type": "textfield",
      "id": "form-demande-retour-order_item_id",
      "key": "order_item_id",
      "description": "Exemple : CMD-1001-L1",
      "validate": {
        "required": true
      }
    },
    {
      "label": "Quantité à retourner",
      "type": "number",
      "id": "form-demande-retour-return_quantity",
      "key": "return_quantity",
      "validate": {
        "required": true,
        "min": 1
      }
    },
    {
      "label": "Motif principal",
      "type": "select",
      "id": "form-demande-retour-return_reason",
      "key": "return_reason",
      "values": [
        {
          "label": "Taille / ajustement",
          "value": "SIZE_FIT"
        },
        {
          "label": "Couleur différente",
          "value": "COLOR_MISMATCH"
        },
        {
          "label": "Qualité du tissu",
          "value": "FABRIC_QUALITY"
        },
        {
          "label": "Coupe / forme",
          "value": "SHAPE_CUT"
        },
        {
          "label": "Article défectueux",
          "value": "DEFECTIVE"
        },
        {
          "label": "Mauvais article reçu",
          "value": "WRONG_ITEM"
        },
        {
          "label": "Non conforme à la description",
          "value": "NOT_AS_DESCRIBED"
        },
        {
          "label": "Autre",
          "value": "OTHER"
        }
      ],
      "validate": {
        "required": true
      }
    },
    {
      "label": "Décrivez le problème et l’état de l’article",
      "type": "textarea",
      "id": "form-demande-retour-description",
      "key": "description",
      "description": "Indiquez les faits utiles : taille, couleur, tissu, coupe ou défaut.",
      "validate": {
        "required": true
      }
    },
    {
      "label": "Solution souhaitée",
      "type": "select",
      "id": "form-demande-retour-requested_resolution",
      "key": "requested_resolution",
      "values": [
        {
          "label": "Remboursement",
          "value": "refund"
        },
        {
          "label": "Échange / remplacement",
          "value": "exchange"
        },
        {
          "label": "Traitement SAV",
          "value": "service"
        },
        {
          "label": "Sans préférence",
          "value": "no_preference"
        }
      ],
      "validate": {
        "required": true
      }
    },
    {
      "label": "Article porté (hors essayage)",
      "type": "select",
      "id": "form-demande-retour-item_worn",
      "key": "item_worn",
      "values": [
        {
          "label": "Oui",
          "value": "yes"
        },
        {
          "label": "Non",
          "value": "no"
        },
        {
          "label": "Je ne sais pas",
          "value": "unknown"
        }
      ],
      "validate": {
        "required": true
      }
    },
    {
      "label": "Article lavé",
      "type": "select",
      "id": "form-demande-retour-item_washed",
      "key": "item_washed",
      "values": [
        {
          "label": "Oui",
          "value": "yes"
        },
        {
          "label": "Non",
          "value": "no"
        },
        {
          "label": "Je ne sais pas",
          "value": "unknown"
        }
      ],
      "validate": {
        "required": true
      }
    },
    {
      "label": "Article modifié",
      "type": "select",
      "id": "form-demande-retour-item_modified",
      "key": "item_modified",
      "values": [
        {
          "label": "Oui",
          "value": "yes"
        },
        {
          "label": "Non",
          "value": "no"
        },
        {
          "label": "Je ne sais pas",
          "value": "unknown"
        }
      ],
      "validate": {
        "required": true
      }
    },
    {
      "label": "Étiquettes d’origine encore attachées",
      "type": "select",
      "id": "form-demande-retour-original_tags_attached",
      "key": "original_tags_attached",
      "values": [
        {
          "label": "Oui",
          "value": "yes"
        },
        {
          "label": "Non",
          "value": "no"
        },
        {
          "label": "Je ne sais pas",
          "value": "unknown"
        }
      ],
      "validate": {
        "required": true
      }
    },
    {
      "label": "Article endommagé selon le client",
      "type": "select",
      "id": "form-demande-retour-item_damaged",
      "key": "item_damaged",
      "values": [
        {
          "label": "Oui",
          "value": "yes"
        },
        {
          "label": "Non",
          "value": "no"
        },
        {
          "label": "Je ne sais pas",
          "value": "unknown"
        }
      ],
      "validate": {
        "required": true
      }
    },
    {
      "label": "Référence de photo fictive",
      "type": "textfield",
      "id": "form-demande-retour-evidence_reference",
      "key": "evidence_reference",
      "description": "Optionnel. Exemple : PHOTO-001"
    }
  ],
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.52.0"
  }
}

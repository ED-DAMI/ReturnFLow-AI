{
  "schemaVersion": 11,
  "type": "default",
  "id": "form-autorisation-sav",
  "components": [
    {
      "type": "text",
      "id": "form-autorisation-sav_text_1",
      "text": "# Autorisation du retour (agent SAV)\nVous décidez d'autoriser ou de refuser le retour **avant expédition**. L'IA est consultative."
    },
    {
      "type": "text",
      "id": "form-autorisation-sav_text_2",
      "text": "## Demande"
    },
    {
      "label": "Commande",
      "type": "textfield",
      "id": "form-autorisation-sav_order_id_3",
      "key": "order_id",
      "readonly": true
    },
    {
      "label": "Ligne d'article",
      "type": "textfield",
      "id": "form-autorisation-sav_order_item_id_4",
      "key": "order_item_id",
      "readonly": true
    },
    {
      "label": "Quantité",
      "type": "number",
      "id": "form-autorisation-sav_return_quantity_5",
      "key": "return_quantity",
      "readonly": true
    },
    {
      "label": "Motif",
      "type": "textfield",
      "id": "form-autorisation-sav_return_reason_6",
      "key": "return_reason",
      "readonly": true
    },
    {
      "label": "Résolution souhaitée",
      "type": "textfield",
      "id": "form-autorisation-sav_requested_resolution_7",
      "key": "requested_resolution",
      "readonly": true
    },
    {
      "label": "Description",
      "type": "textarea",
      "id": "form-autorisation-sav_description_8",
      "key": "description",
      "readonly": true
    },
    {
      "type": "text",
      "id": "form-autorisation-sav_text_9",
      "text": "## Contrôle d'éligibilité (règles métier)"
    },
    {
      "label": "Statut d'éligibilité",
      "type": "textfield",
      "id": "form-autorisation-sav_eligibility_status_10",
      "key": "eligibility_status",
      "readonly": true
    },
    {
      "label": "Détails des règles appliquées",
      "type": "textarea",
      "id": "form-autorisation-sav_eligibility_reason_11",
      "key": "eligibility_reason",
      "readonly": true
    },
    {
      "type": "text",
      "id": "form-autorisation-sav_text_12",
      "text": "## Analyse"
    },
    {
      "label": "Statut de l'analyse IA",
      "type": "textfield",
      "id": "form-autorisation-sav_ai_status_13",
      "key": "ai_status",
      "description": "ok ou fallback (IA indisponible)",
      "readonly": true
    },
    {
      "label": "Catégorie (IA)",
      "type": "textfield",
      "id": "form-autorisation-sav_ai_category_14",
      "key": "ai_category",
      "readonly": true,
      "conditional": {
        "hide": "=ai_status = \"fallback\""
      }
    },
    {
      "label": "Résumé (IA)",
      "type": "textarea",
      "id": "form-autorisation-sav_ai_summary_15",
      "key": "ai_summary",
      "readonly": true,
      "conditional": {
        "hide": "=ai_status = \"fallback\""
      }
    },
    {
      "label": "Résolution suggérée (IA)",
      "type": "textfield",
      "id": "form-autorisation-sav_ai_suggested_resolution_16",
      "key": "ai_suggested_resolution",
      "readonly": true,
      "conditional": {
        "hide": "=ai_status = \"fallback\""
      }
    },
    {
      "label": "Analyse manuelle (IA indisponible)",
      "type": "textarea",
      "id": "form-autorisation-sav_manual_analysis_note_17",
      "key": "manual_analysis_note",
      "description": "Saisissez votre analyse du dossier",
      "validate": {
        "required": true
      },
      "conditional": {
        "hide": "=ai_status != \"fallback\""
      }
    },
    {
      "type": "text",
      "id": "form-autorisation-sav_text_18",
      "text": "## Décision de l'agent"
    },
    {
      "label": "Décision",
      "type": "radio",
      "id": "form-autorisation-sav_agent_decision_19",
      "key": "agent_decision",
      "validate": {
        "required": true
      },
      "values": [
        {
          "label": "Autoriser le retour",
          "value": "authorized"
        },
        {
          "label": "Refuser le retour",
          "value": "refused"
        }
      ]
    },
    {
      "label": "Justification",
      "type": "textarea",
      "id": "form-autorisation-sav_agent_justification_20",
      "key": "agent_justification",
      "validate": {
        "required": true
      }
    }
  ],
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.5.0",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.22.0"
  }
}
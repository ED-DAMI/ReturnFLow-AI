<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_ReturnFlowAI" targetNamespace="http://returnflow.ai/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:process id="returnflow-ai-shein-rag" name="ReturnFlow AI - Cas académique SHEIN | Retours vêtements + RAG" isExecutable="true">
    <bpmn:documentation>Cas d'étude académique inspiré des politiques publiques de retour SHEIN Maroc. Le processus interne réel de SHEIN n'est pas reproduit. Périmètre: vêtements et motifs taille/fit, couleur, tissu/qualité, coupe/forme, article défectueux, mauvais article, non conforme à la description. Le worker unique shein-agent traite toutes les tâches automatisées: recherche de commande, contrôles, RAG, extraction des faits, règles/DMN, génération des réponses, notifications et résolution simulée. La décision humaine SAV reste traçable.</bpmn:documentation>
    <bpmn:textAnnotation id="TextAnnotation_SheinAgent"><bpmn:text>shein-agent&#10;Worker unique des tâches automatisées</bpmn:text></bpmn:textAnnotation>
    <bpmn:startEvent id="StartEvent_ReturnRequest" name="Demande de retour reçue">
      <bpmn:outgoing>Flow_Start_To_Submit</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_SubmitReturn" name="Saisir la demande de retour">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-demande-retour" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_To_Submit</bpmn:incoming>
      <bpmn:outgoing>Flow_Submit_To_Fetch</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_FetchOrder" name="Récupérer la commande, l'article et la fiche produit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="shein-agent" retries="3"/><zeebe:taskHeaders><zeebe:header key="operation" value="fetch-fashion-order-item"/></zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Submit_To_Fetch</bpmn:incoming>
      <bpmn:incoming>Flow_Correction_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Fetch_To_OrderFound</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_OrderFound" name="Commande / article trouvé ?" default="Flow_OrderFound_No">
      <bpmn:incoming>Flow_Fetch_To_OrderFound</bpmn:incoming>
      <bpmn:outgoing>Flow_OrderFound_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_OrderFound_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_RequestCorrection" name="Demander correction des références">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-correction-references" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_OrderFound_No</bpmn:incoming>
      <bpmn:outgoing>Flow_RequestCorrection_To_CorrectionProvided</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_CorrectionProvided" name="Correction fournie ?" default="Flow_Correction_No">
      <bpmn:incoming>Flow_RequestCorrection_To_CorrectionProvided</bpmn:incoming>
      <bpmn:outgoing>Flow_Correction_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Correction_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_OrderNotFound" name="Clôturé - commande introuvable">
      <bpmn:incoming>Flow_Correction_No</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_CheckMinimumInfo" name="Valider les informations minimales">
  <bpmn:extensionElements><zeebe:taskDefinition type="shein-agent" retries="3"/><zeebe:taskHeaders><zeebe:header key="operation" value="validate-return-data"/></zeebe:taskHeaders></bpmn:extensionElements>
  <bpmn:incoming>Flow_OrderFound_Yes</bpmn:incoming>
  <bpmn:incoming>Flow_AdditionalInfo_To_Check</bpmn:incoming>
  <bpmn:outgoing>Flow_Check_To_InfoComplete</bpmn:outgoing>
</bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_InfoComplete" name="Informations complètes ?" default="Flow_InfoComplete_No">
      <bpmn:incoming>Flow_Check_To_InfoComplete</bpmn:incoming>
      <bpmn:outgoing>Flow_InfoComplete_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_InfoComplete_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_RequestAdditionalInfo" name="Demander complément au client">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-complement-information" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_InfoComplete_No</bpmn:incoming>
      <bpmn:outgoing>Flow_AdditionalInfo_To_Check</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Boundary_InfoTimeout" name="48 h sans réponse" attachedToRef="Task_RequestAdditionalInfo" cancelActivity="true">
      <bpmn:outgoing>Flow_InfoTimeout_To_End</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">PT48H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="End_Incomplete" name="Clôturé - informations incomplètes">
      <bpmn:incoming>Flow_InfoTimeout_To_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="SubProcess_EvaluateRequest" name="Évaluer la demande - RAG + règles métier">
  <bpmn:incoming>Flow_InfoComplete_Yes</bpmn:incoming>
  <bpmn:outgoing>Flow_Evaluate_To_Eligible</bpmn:outgoing>
  <bpmn:startEvent id="Start_Evaluate"><bpmn:outgoing>Flow_EvalStart_To_AI</bpmn:outgoing></bpmn:startEvent>
  <bpmn:serviceTask id="Task_AIAnalysis" name="Analyser le motif du retour (LLM / OpenRouter)">
    <bpmn:documentation>Classifie le motif: SIZE_FIT, COLOR_MISMATCH, FABRIC_QUALITY, SHAPE_CUT, DEFECTIVE, WRONG_ITEM, NOT_AS_DESCRIBED, OTHER. Produit résumé, sentiment, urgence et aiAvailable.</bpmn:documentation>
    <bpmn:extensionElements><zeebe:taskDefinition type="shein-agent" retries="2"/><zeebe:taskHeaders><zeebe:header key="operation" value="classify-fashion-return"/></zeebe:taskHeaders></bpmn:extensionElements>
    <bpmn:incoming>Flow_EvalStart_To_AI</bpmn:incoming><bpmn:outgoing>Flow_AI_To_Available</bpmn:outgoing>
  </bpmn:serviceTask>
  <bpmn:exclusiveGateway id="Gateway_AIAvailable" name="IA disponible ?" default="Flow_AI_No">
    <bpmn:incoming>Flow_AI_To_Available</bpmn:incoming><bpmn:outgoing>Flow_AI_Yes</bpmn:outgoing><bpmn:outgoing>Flow_AI_No</bpmn:outgoing>
  </bpmn:exclusiveGateway>
  <bpmn:serviceTask id="Task_RetrievePolicyRAG" name="Rechercher les politiques via le RAG de shein-agent">
    <bpmn:documentation>shein-agent effectue une recherche sémantique dans les sources intégrées: politique de retour publique, FAQ, règles vêtements, guides tailles et fiches produits. Retourne policyChunks, sourceIds, similarityScores, ragContextFound.</bpmn:documentation>
    <bpmn:extensionElements><zeebe:taskDefinition type="shein-agent" retries="3"/><zeebe:taskHeaders><zeebe:header key="operation" value="retrieve-return-policy-rag"/></zeebe:taskHeaders></bpmn:extensionElements>
    <bpmn:incoming>Flow_AI_Yes</bpmn:incoming><bpmn:outgoing>Flow_RAG_To_Context</bpmn:outgoing>
  </bpmn:serviceTask>
  <bpmn:exclusiveGateway id="Gateway_RAGContext" name="Contexte RAG suffisant ?" default="Flow_RAG_No">
    <bpmn:incoming>Flow_RAG_To_Context</bpmn:incoming><bpmn:outgoing>Flow_RAG_Yes</bpmn:outgoing><bpmn:outgoing>Flow_RAG_No</bpmn:outgoing>
  </bpmn:exclusiveGateway>
  <bpmn:serviceTask id="Task_ExtractFacts" name="Extraire les faits + preuves citées">
    <bpmn:documentation>Sortie structurée: catégorie, jours depuis réception, état, porté/lavé/modifié, étiquettes, défaut, preuves et références de politique utilisées. Le LLM n'accorde pas le retour.</bpmn:documentation>
    <bpmn:extensionElements><zeebe:taskDefinition type="shein-agent" retries="2"/><zeebe:taskHeaders><zeebe:header key="operation" value="extract-grounded-return-facts"/></zeebe:taskHeaders></bpmn:extensionElements>
    <bpmn:incoming>Flow_RAG_Yes</bpmn:incoming><bpmn:outgoing>Flow_Facts_To_Eligibility</bpmn:outgoing>
  </bpmn:serviceTask>
  <bpmn:userTask id="Task_ManualAnalysis" name="Analyse manuelle des faits / règles">
    <bpmn:extensionElements>
      <zeebe:userTask />
      <zeebe:formDefinition formId="form-analyse-manuelle" />
    </bpmn:extensionElements>
    <bpmn:documentation>Fallback si OpenRouter est indisponible ou si le RAG ne fournit pas un contexte suffisant.</bpmn:documentation>
    <bpmn:incoming>Flow_AI_No</bpmn:incoming><bpmn:incoming>Flow_RAG_No</bpmn:incoming><bpmn:outgoing>Flow_Manual_To_Eligibility</bpmn:outgoing>
  </bpmn:userTask>
  <bpmn:serviceTask id="Task_EvaluateEligibility" name="Évaluer l'éligibilité (règles déterministes / DMN)">
    <bpmn:documentation>Décision déterministe à partir des faits structurés et des règles sourcées. Base académique alignée sur la politique publique SHEIN Maroc: la plupart des articles neufs sont retournables sous conditions dans les 30 jours suivant la réception; les vêtements doivent notamment être neufs, non portés, non lavés, non endommagés, non modifiés, avec les étiquettes d'origine attachées; certaines catégories (par ex. bodys, maillots de bain, lingerie, sous-vêtements) sont non retournables; un article reçu défectueux ou endommagé suit le chemin SAV dédié si le client contacte le service client dans le délai public indiqué. Le LLM ne prend jamais seul la décision finale.</bpmn:documentation>
    <bpmn:extensionElements><zeebe:taskDefinition type="shein-agent" retries="3"/><zeebe:taskHeaders><zeebe:header key="operation" value="evaluate-return-eligibility"/></zeebe:taskHeaders></bpmn:extensionElements>
    <bpmn:incoming>Flow_Facts_To_Eligibility</bpmn:incoming><bpmn:incoming>Flow_Manual_To_Eligibility</bpmn:incoming><bpmn:outgoing>Flow_Eligibility_To_EvalEnd</bpmn:outgoing>
  </bpmn:serviceTask>
  <bpmn:endEvent id="End_Evaluate"><bpmn:incoming>Flow_Eligibility_To_EvalEnd</bpmn:incoming></bpmn:endEvent>
  <bpmn:sequenceFlow id="Flow_EvalStart_To_AI" sourceRef="Start_Evaluate" targetRef="Task_AIAnalysis"/>
  <bpmn:sequenceFlow id="Flow_AI_To_Available" sourceRef="Task_AIAnalysis" targetRef="Gateway_AIAvailable"/>
  <bpmn:sequenceFlow id="Flow_AI_Yes" name="Oui" sourceRef="Gateway_AIAvailable" targetRef="Task_RetrievePolicyRAG"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= aiAvailable = true</bpmn:conditionExpression></bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="Flow_AI_No" name="Non / fallback" sourceRef="Gateway_AIAvailable" targetRef="Task_ManualAnalysis"/>
  <bpmn:sequenceFlow id="Flow_RAG_To_Context" sourceRef="Task_RetrievePolicyRAG" targetRef="Gateway_RAGContext"/>
  <bpmn:sequenceFlow id="Flow_RAG_Yes" name="Oui" sourceRef="Gateway_RAGContext" targetRef="Task_ExtractFacts"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= ragContextFound = true</bpmn:conditionExpression></bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="Flow_RAG_No" name="Non / revue manuelle" sourceRef="Gateway_RAGContext" targetRef="Task_ManualAnalysis"/>
  <bpmn:sequenceFlow id="Flow_Facts_To_Eligibility" sourceRef="Task_ExtractFacts" targetRef="Task_EvaluateEligibility"/>
  <bpmn:sequenceFlow id="Flow_Manual_To_Eligibility" sourceRef="Task_ManualAnalysis" targetRef="Task_EvaluateEligibility"/>
  <bpmn:sequenceFlow id="Flow_Eligibility_To_EvalEnd" sourceRef="Task_EvaluateEligibility" targetRef="End_Evaluate"/>
</bpmn:subProcess>
    <bpmn:exclusiveGateway id="Gateway_Eligible" name="Retour éligible selon règles ?" default="Flow_Eligible_No">
      <bpmn:incoming>Flow_Evaluate_To_Eligible</bpmn:incoming>
      <bpmn:outgoing>Flow_Eligible_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Eligible_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_GenerateRefusal" name="Générer un refus expliqué et sourcé">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="shein-agent" retries="2"/><zeebe:taskHeaders><zeebe:header key="operation" value="generate-grounded-refusal-response"/></zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Eligible_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Refusal_To_Notify</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_NotifyRefusal" name="Notifier le client du refus">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="shein-agent" retries="3"/><zeebe:taskHeaders><zeebe:header key="operation" value="notify-client"/></zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Refusal_To_Notify</bpmn:incoming>
      <bpmn:outgoing>Flow_NotifyRefusal_To_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Refused" name="Dossier refusé et clôturé">
      <bpmn:incoming>Flow_NotifyRefusal_To_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="SubProcess_HandleAuthorizedReturn" name="Traiter le retour autorisé - human-in-the-loop + contrôle qualité">
  <bpmn:incoming>Flow_Eligible_Yes</bpmn:incoming><bpmn:outgoing>Flow_Handle_To_Resolve</bpmn:outgoing>
  <bpmn:startEvent id="Start_Handle"><bpmn:outgoing>Flow_HandleStart_To_Validate</bpmn:outgoing></bpmn:startEvent>
  <bpmn:userTask id="Task_ValidateSolution" name="Valider la solution proposée par l'IA">
    <bpmn:extensionElements>
      <zeebe:userTask />
      <zeebe:formDefinition formId="form-validation-sav" />
    </bpmn:extensionElements>
    <bpmn:documentation>L'agent SAV voit le motif, résumé, confiance, règles citées, recommandation et décide. Il peut modifier returnRequired et le mode de remboursement.</bpmn:documentation>
    <bpmn:incoming>Flow_HandleStart_To_Validate</bpmn:incoming><bpmn:outgoing>Flow_Validate_To_ReturnRequired</bpmn:outgoing>
  </bpmn:userTask>
  <bpmn:boundaryEvent id="Boundary_SLA24h" name="SLA 24 h dépassé" attachedToRef="Task_ValidateSolution" cancelActivity="false">
    <bpmn:outgoing>Flow_SLA_To_Escalate</bpmn:outgoing>
    <bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT24H</bpmn:timeDuration></bpmn:timerEventDefinition>
  </bpmn:boundaryEvent>
  <bpmn:userTask id="Task_EscalateSupervisor" name="Escalader / relancer le superviseur">
    <bpmn:extensionElements>
      <zeebe:userTask />
      <zeebe:formDefinition formId="form-escalade-sav" />
    </bpmn:extensionElements>
    <bpmn:incoming>Flow_SLA_To_Escalate</bpmn:incoming><bpmn:outgoing>Flow_Escalate_To_End</bpmn:outgoing>
  </bpmn:userTask>
  <bpmn:endEvent id="End_Escalation"><bpmn:incoming>Flow_Escalate_To_End</bpmn:incoming></bpmn:endEvent>
  <bpmn:exclusiveGateway id="Gateway_ReturnRequired" name="Retour physique requis ?" default="Flow_ReturnRequired_Yes">
    <bpmn:incoming>Flow_Validate_To_ReturnRequired</bpmn:incoming><bpmn:outgoing>Flow_ReturnRequired_Yes</bpmn:outgoing><bpmn:outgoing>Flow_ReturnRequired_No</bpmn:outgoing>
  </bpmn:exclusiveGateway>
  <bpmn:serviceTask id="Task_SendReturnInstructions" name="Envoyer les instructions de retour">
    <bpmn:extensionElements><zeebe:taskDefinition type="shein-agent" retries="3"/><zeebe:taskHeaders><zeebe:header key="operation" value="send-return-instructions"/></zeebe:taskHeaders></bpmn:extensionElements>
    <bpmn:incoming>Flow_ReturnRequired_Yes</bpmn:incoming><bpmn:outgoing>Flow_Instructions_To_Receipt</bpmn:outgoing>
  </bpmn:serviceTask>
  <bpmn:userTask id="Task_ConfirmReceipt" name="Confirmer la réception du vêtement">
    <bpmn:extensionElements>
      <zeebe:userTask />
      <zeebe:formDefinition formId="form-reception-produit" />
    </bpmn:extensionElements>
    <bpmn:incoming>Flow_Instructions_To_Receipt</bpmn:incoming><bpmn:outgoing>Flow_Receipt_To_Inspect</bpmn:outgoing>
  </bpmn:userTask>
  <bpmn:userTask id="Task_InspectProduct" name="Inspecter l'état, les étiquettes et la conformité">
    <bpmn:extensionElements>
      <zeebe:userTask />
      <zeebe:formDefinition formId="form-inspection-produit" />
    </bpmn:extensionElements>
    <bpmn:incoming>Flow_Receipt_To_Inspect</bpmn:incoming><bpmn:outgoing>Flow_Inspect_To_Consistent</bpmn:outgoing>
  </bpmn:userTask>
  <bpmn:exclusiveGateway id="Gateway_ProductConsistent" name="Contrôle qualité validé ?" default="Flow_Consistent_No">
    <bpmn:incoming>Flow_Inspect_To_Consistent</bpmn:incoming><bpmn:outgoing>Flow_Consistent_Yes</bpmn:outgoing><bpmn:outgoing>Flow_Consistent_No</bpmn:outgoing>
  </bpmn:exclusiveGateway>
  <bpmn:userTask id="Task_ReevaluateResolution" name="Réévaluer le dossier après inspection">
    <bpmn:extensionElements>
      <zeebe:userTask />
      <zeebe:formDefinition formId="form-reanalyse-apres-inspection" />
    </bpmn:extensionElements>
    <bpmn:incoming>Flow_Consistent_No</bpmn:incoming><bpmn:outgoing>Flow_Reevaluate_To_HandleEnd</bpmn:outgoing>
  </bpmn:userTask>
  <bpmn:endEvent id="End_Handle"><bpmn:incoming>Flow_ReturnRequired_No</bpmn:incoming><bpmn:incoming>Flow_Consistent_Yes</bpmn:incoming><bpmn:incoming>Flow_Reevaluate_To_HandleEnd</bpmn:incoming></bpmn:endEvent>
  <bpmn:sequenceFlow id="Flow_HandleStart_To_Validate" sourceRef="Start_Handle" targetRef="Task_ValidateSolution"/>
  <bpmn:sequenceFlow id="Flow_Validate_To_ReturnRequired" sourceRef="Task_ValidateSolution" targetRef="Gateway_ReturnRequired"/>
  <bpmn:sequenceFlow id="Flow_SLA_To_Escalate" sourceRef="Boundary_SLA24h" targetRef="Task_EscalateSupervisor"/>
  <bpmn:sequenceFlow id="Flow_Escalate_To_End" sourceRef="Task_EscalateSupervisor" targetRef="End_Escalation"/>
  <bpmn:sequenceFlow id="Flow_ReturnRequired_Yes" name="Oui" sourceRef="Gateway_ReturnRequired" targetRef="Task_SendReturnInstructions"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= returnRequired = true</bpmn:conditionExpression></bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="Flow_ReturnRequired_No" name="Non / remboursement sans retour" sourceRef="Gateway_ReturnRequired" targetRef="End_Handle"/>
  <bpmn:sequenceFlow id="Flow_Instructions_To_Receipt" sourceRef="Task_SendReturnInstructions" targetRef="Task_ConfirmReceipt"/>
  <bpmn:sequenceFlow id="Flow_Receipt_To_Inspect" sourceRef="Task_ConfirmReceipt" targetRef="Task_InspectProduct"/>
  <bpmn:sequenceFlow id="Flow_Inspect_To_Consistent" sourceRef="Task_InspectProduct" targetRef="Gateway_ProductConsistent"/>
  <bpmn:sequenceFlow id="Flow_Consistent_Yes" name="Oui" sourceRef="Gateway_ProductConsistent" targetRef="End_Handle"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= qualityCheckPassed = true</bpmn:conditionExpression></bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="Flow_Consistent_No" name="Non / réévaluer" sourceRef="Gateway_ProductConsistent" targetRef="Task_ReevaluateResolution"/>
  <bpmn:sequenceFlow id="Flow_Reevaluate_To_HandleEnd" sourceRef="Task_ReevaluateResolution" targetRef="End_Handle"/>
</bpmn:subProcess>
    <bpmn:subProcess id="SubProcess_ResolveCase" name="Résoudre le dossier - remboursement / exception SAV">
      <bpmn:incoming>Flow_Handle_To_Resolve</bpmn:incoming>
      <bpmn:outgoing>Flow_Resolve_To_FinalResponse</bpmn:outgoing>
      <bpmn:startEvent id="Start_Resolve">
        <bpmn:outgoing>Flow_ResolveStart_To_Decide</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="Task_DecideResolution" name="Confirmer le mode de remboursement / traitement">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="form-resolution-sav" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_ResolveStart_To_Decide</bpmn:incoming>
        <bpmn:outgoing>Flow_Decide_To_Type</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="Gateway_ResolutionType" name="Mode de remboursement / traitement ?" default="Flow_Resolution_Manual">
        <bpmn:incoming>Flow_Decide_To_Type</bpmn:incoming>
        <bpmn:outgoing>Flow_Resolution_Refund</bpmn:outgoing>
        <bpmn:outgoing>Flow_Resolution_Exchange</bpmn:outgoing>
        <bpmn:outgoing>Flow_Resolution_Repair</bpmn:outgoing>
        <bpmn:outgoing>Flow_Resolution_Manual</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="Task_ExecuteRefund" name="Rembourser sur portefeuille SHEIN">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="shein-agent" retries="3"/><zeebe:taskHeaders><zeebe:header key="operation" value="refund-shein-wallet"/></zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_Resolution_Refund</bpmn:incoming>
        <bpmn:outgoing>Flow_Refund_To_Merge</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Task_ExecuteExchange" name="Rembourser sur moyen de paiement initial">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="shein-agent" retries="3"/><zeebe:taskHeaders><zeebe:header key="operation" value="refund-original-payment"/></zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_Resolution_Exchange</bpmn:incoming>
        <bpmn:outgoing>Flow_Exchange_To_Merge</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Task_ExecuteRepair" name="Remboursement sans retour">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="shein-agent" retries="3"/><zeebe:taskHeaders><zeebe:header key="operation" value="refund-without-return"/></zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_Resolution_Repair</bpmn:incoming>
        <bpmn:outgoing>Flow_Repair_To_Merge</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="Task_ManualResolution" name="Traiter une exception SAV manuellement">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="form-resolution-exception" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_Resolution_Manual</bpmn:incoming>
        <bpmn:outgoing>Flow_ManualResolution_To_Merge</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="Gateway_ResolutionMerge">
        <bpmn:incoming>Flow_Refund_To_Merge</bpmn:incoming>
        <bpmn:incoming>Flow_Exchange_To_Merge</bpmn:incoming>
        <bpmn:incoming>Flow_Repair_To_Merge</bpmn:incoming>
        <bpmn:incoming>Flow_ManualResolution_To_Merge</bpmn:incoming>
        <bpmn:outgoing>Flow_Merge_To_ResolveEnd</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="End_Resolve">
        <bpmn:incoming>Flow_Merge_To_ResolveEnd</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_ResolveStart_To_Decide" sourceRef="Start_Resolve" targetRef="Task_DecideResolution"/>
      <bpmn:sequenceFlow id="Flow_Decide_To_Type" sourceRef="Task_DecideResolution" targetRef="Gateway_ResolutionType"/>
      <bpmn:sequenceFlow id="Flow_Resolution_Refund" name="Portefeuille SHEIN" sourceRef="Gateway_ResolutionType" targetRef="Task_ExecuteRefund">
        <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">= refundMethod = "shein_wallet"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_Resolution_Exchange" name="Paiement initial" sourceRef="Gateway_ResolutionType" targetRef="Task_ExecuteExchange">
        <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">= refundMethod = "original_payment"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_Resolution_Repair" name="Sans retour" sourceRef="Gateway_ResolutionType" targetRef="Task_ExecuteRepair">
        <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">= refundMethod = "returnless"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_Resolution_Manual" name="Exception / fallback" sourceRef="Gateway_ResolutionType" targetRef="Task_ManualResolution"/>
      <bpmn:sequenceFlow id="Flow_Refund_To_Merge" sourceRef="Task_ExecuteRefund" targetRef="Gateway_ResolutionMerge"/>
      <bpmn:sequenceFlow id="Flow_Exchange_To_Merge" sourceRef="Task_ExecuteExchange" targetRef="Gateway_ResolutionMerge"/>
      <bpmn:sequenceFlow id="Flow_Repair_To_Merge" sourceRef="Task_ExecuteRepair" targetRef="Gateway_ResolutionMerge"/>
      <bpmn:sequenceFlow id="Flow_ManualResolution_To_Merge" sourceRef="Task_ManualResolution" targetRef="Gateway_ResolutionMerge"/>
      <bpmn:sequenceFlow id="Flow_Merge_To_ResolveEnd" sourceRef="Gateway_ResolutionMerge" targetRef="End_Resolve"/>
    </bpmn:subProcess>
    <bpmn:serviceTask id="Task_GenerateFinalResponse" name="Générer la réponse finale personnalisée (LLM)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="shein-agent" retries="2"/><zeebe:taskHeaders><zeebe:header key="operation" value="generate-grounded-final-response"/></zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Resolve_To_FinalResponse</bpmn:incoming>
      <bpmn:outgoing>Flow_FinalResponse_To_Notify</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_NotifyClient" name="Notifier le client">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="shein-agent" retries="3"/><zeebe:taskHeaders><zeebe:header key="operation" value="notify-client"/></zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_FinalResponse_To_Notify</bpmn:incoming>
      <bpmn:outgoing>Flow_Notify_To_Close</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_CloseCase" name="Clôturer le dossier">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-cloture-dossier" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Notify_To_Close</bpmn:incoming>
      <bpmn:outgoing>Flow_Close_To_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Completed" name="Dossier terminé">
      <bpmn:incoming>Flow_Close_To_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:association id="Association_RAG_SheinAgent" sourceRef="Task_RetrievePolicyRAG" targetRef="TextAnnotation_SheinAgent" associationDirection="None"/>
    <bpmn:sequenceFlow id="Flow_Start_To_Submit" sourceRef="StartEvent_ReturnRequest" targetRef="Task_SubmitReturn"/>
    <bpmn:sequenceFlow id="Flow_Submit_To_Fetch" sourceRef="Task_SubmitReturn" targetRef="Task_FetchOrder"/>
    <bpmn:sequenceFlow id="Flow_Fetch_To_OrderFound" sourceRef="Task_FetchOrder" targetRef="Gateway_OrderFound"/>
    <bpmn:sequenceFlow id="Flow_OrderFound_Yes" name="Oui" sourceRef="Gateway_OrderFound" targetRef="Task_CheckMinimumInfo">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">= orderFound = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_OrderFound_No" name="Non" sourceRef="Gateway_OrderFound" targetRef="Task_RequestCorrection"/>
    <bpmn:sequenceFlow id="Flow_RequestCorrection_To_CorrectionProvided" sourceRef="Task_RequestCorrection" targetRef="Gateway_CorrectionProvided"/>
    <bpmn:sequenceFlow id="Flow_Correction_Yes" name="Oui" sourceRef="Gateway_CorrectionProvided" targetRef="Task_FetchOrder">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">= correctionProvided = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Correction_No" name="Non" sourceRef="Gateway_CorrectionProvided" targetRef="End_OrderNotFound"/>
    <bpmn:sequenceFlow id="Flow_Check_To_InfoComplete" sourceRef="Task_CheckMinimumInfo" targetRef="Gateway_InfoComplete"/>
    <bpmn:sequenceFlow id="Flow_InfoComplete_Yes" name="Oui" sourceRef="Gateway_InfoComplete" targetRef="SubProcess_EvaluateRequest">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">= infoComplete = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_InfoComplete_No" name="Non" sourceRef="Gateway_InfoComplete" targetRef="Task_RequestAdditionalInfo"/>
    <bpmn:sequenceFlow id="Flow_AdditionalInfo_To_Check" name="Complément reçu" sourceRef="Task_RequestAdditionalInfo" targetRef="Task_CheckMinimumInfo"/>
    <bpmn:sequenceFlow id="Flow_InfoTimeout_To_End" sourceRef="Boundary_InfoTimeout" targetRef="End_Incomplete"/>
    <bpmn:sequenceFlow id="Flow_Evaluate_To_Eligible" sourceRef="SubProcess_EvaluateRequest" targetRef="Gateway_Eligible"/>
    <bpmn:sequenceFlow id="Flow_Eligible_Yes" name="Oui" sourceRef="Gateway_Eligible" targetRef="SubProcess_HandleAuthorizedReturn">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">= eligibility = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Eligible_No" name="Non" sourceRef="Gateway_Eligible" targetRef="Task_GenerateRefusal"/>
    <bpmn:sequenceFlow id="Flow_Refusal_To_Notify" sourceRef="Task_GenerateRefusal" targetRef="Task_NotifyRefusal"/>
    <bpmn:sequenceFlow id="Flow_NotifyRefusal_To_End" sourceRef="Task_NotifyRefusal" targetRef="End_Refused"/>
    <bpmn:sequenceFlow id="Flow_Handle_To_Resolve" sourceRef="SubProcess_HandleAuthorizedReturn" targetRef="SubProcess_ResolveCase"/>
    <bpmn:sequenceFlow id="Flow_Resolve_To_FinalResponse" sourceRef="SubProcess_ResolveCase" targetRef="Task_GenerateFinalResponse"/>
    <bpmn:sequenceFlow id="Flow_FinalResponse_To_Notify" sourceRef="Task_GenerateFinalResponse" targetRef="Task_NotifyClient"/>
    <bpmn:sequenceFlow id="Flow_Notify_To_Close" sourceRef="Task_NotifyClient" targetRef="Task_CloseCase"/>
    <bpmn:sequenceFlow id="Flow_Close_To_End" sourceRef="Task_CloseCase" targetRef="End_Completed"/>
  </bpmn:process>

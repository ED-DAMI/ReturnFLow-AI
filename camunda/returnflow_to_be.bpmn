<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_returnflow_to_be" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:error id="Error_AI" name="AI_UNAVAILABLE" errorCode="AI_UNAVAILABLE" />
  <bpmn:error id="Error_Exec" name="EXEC_FAILED" errorCode="EXEC_FAILED" />
  <bpmn:process id="returnflow_to_be" name="ReturnFlow AI - TO-BE" isExecutable="true">
    <bpmn:startEvent id="Start_Demande" name="Demande de retour reçue">
      <bpmn:outgoing>Flow_Start_Demande_Task_Saisie</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Saisie" name="Saisir la demande">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-demande-retour" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Demande_Task_Saisie</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_Saisie_Task_Commande</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_Commande" name="Récupérer la commande et l&#39;article">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="GET" target="method" />
          <zeebe:input source="=&#34;http://host.docker.internal:8000&#34; + &#34;/orders/&#34; + string(order_id)" target="url" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultExpression" value="={order_found: response.body.found, order: response.body}" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Task_Saisie_Task_Commande</bpmn:incoming>
      <bpmn:incoming>Flow_GW_Correction_Task_Commande</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_Commande_GW_Trouve</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_Trouve" name="Commande et article trouvés ?" default="Flow_GW_Trouve_Task_Correction">
      <bpmn:incoming>Flow_Task_Commande_GW_Trouve</bpmn:incoming>
      <bpmn:outgoing>Flow_GW_Trouve_Task_Verif</bpmn:outgoing>
      <bpmn:outgoing>Flow_GW_Trouve_Task_Correction</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_Verif" name="Vérifier les informations">
      <bpmn:extensionElements>
        <zeebe:script expression="=is defined(order_id) and order_id != null and is defined(order_item_id) and order_item_id != null and is defined(return_quantity) and return_quantity != null and is defined(return_reason) and return_reason != null and is defined(description) and description != null" resultVariable="is_complete" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_GW_Trouve_Task_Verif</bpmn:incoming>
      <bpmn:incoming>Flow_Task_Complement_Task_Verif</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_Verif_GW_Complete</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="GW_Complete" name="Demande complète ?" default="Flow_GW_Complete_Task_Complement">
      <bpmn:incoming>Flow_Task_Verif_GW_Complete</bpmn:incoming>
      <bpmn:outgoing>Flow_GW_Complete_Task_Eligibilite</bpmn:outgoing>
      <bpmn:outgoing>Flow_GW_Complete_Task_Complement</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Eligibilite" name="Vérifier l&#39;éligibilité">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="=&#34;http://host.docker.internal:8000&#34; + &#34;/eligibility&#34;" target="url" />
          <zeebe:input source="={&#34;Content-Type&#34;:&#34;application/json&#34;}" target="headers" />
          <zeebe:input source="={order_id: if is defined(order_id) then order_id else null, order_item_id: if is defined(order_item_id) then order_item_id else null, return_quantity: if is defined(return_quantity) then return_quantity else null, return_reason: if is defined(return_reason) then return_reason else null}" target="body" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultExpression" value="={eligibility_status: response.body.eligibility_status, eligibility_reasons: response.body.reasons}" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_GW_Complete_Task_Eligibilite</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_Eligibilite_Task_AI</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_AI" name="Analyser la demande avec IA">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="=&#34;http://host.docker.internal:8000&#34; + &#34;/ai/analyze&#34;" target="url" />
          <zeebe:input source="={&#34;Content-Type&#34;:&#34;application/json&#34;}" target="headers" />
          <zeebe:input source="={order_id: if is defined(order_id) then order_id else null, order_item_id: if is defined(order_item_id) then order_item_id else null, return_quantity: if is defined(return_quantity) then return_quantity else null, return_reason: if is defined(return_reason) then return_reason else null, description: if is defined(description) then description else null, eligibility_status: if is defined(eligibility_status) then eligibility_status else null}" target="body" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultExpression" value="={ai_status: response.body.ai_status, ai_suggestion: response.body.analysis}" />
          <zeebe:header key="errorExpression" value="=if error != null then bpmnError(&#34;AI_UNAVAILABLE&#34;, &#34;IA indisponible&#34;) else null" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Task_Eligibilite_Task_AI</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_AI_Task_Autor</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Evt_AI_Err" name="IA indisponible" attachedToRef="Task_AI">
      <bpmn:outgoing>Flow_Evt_AI_Err_Task_Fallback</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrDef_AI" errorRef="Error_AI" />
    </bpmn:boundaryEvent>
    <bpmn:scriptTask id="Task_Fallback" name="Passer en analyse manuelle">
      <bpmn:extensionElements>
        <zeebe:script expression="=&#34;fallback&#34;" resultVariable="ai_status" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Evt_AI_Err_Task_Fallback</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_Fallback_Task_Autor</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:userTask id="Task_Autor" name="Autoriser ou refuser le retour">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-autorisation-sav" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Task_AI_Task_Autor</bpmn:incoming>
      <bpmn:incoming>Flow_Task_Fallback_Task_Autor</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_Autor_GW_Autorise</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Evt_SLA" name="SLA 24 h dépassé" cancelActivity="false" attachedToRef="Task_Autor">
      <bpmn:outgoing>Flow_Evt_SLA_Task_RelanceSAV</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT24H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:scriptTask id="Task_RelanceSAV" name="Enregistrer la relance et informer le responsable SAV">
      <bpmn:extensionElements>
        <zeebe:script expression="=if is defined(sla_breaches) then sla_breaches + 1 else 1" resultVariable="sla_breaches" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Evt_SLA_Task_RelanceSAV</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_RelanceSAV_End_Escalade</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="End_Escalade" name="Escalade envoyée">
      <bpmn:incoming>Flow_Task_RelanceSAV_End_Escalade</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="GW_Autorise" name="Retour autorisé ?" default="Flow_GW_Autorise_Task_Enregistrement">
      <bpmn:incoming>Flow_Task_Autor_GW_Autorise</bpmn:incoming>
      <bpmn:outgoing>Flow_GW_Autorise_Task_RMA</bpmn:outgoing>
      <bpmn:outgoing>Flow_GW_Autorise_Task_Enregistrement</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Enregistrement" name="Enregistrer le dossier (refus ou clôture motivée)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="=&#34;http://host.docker.internal:8000&#34; + &#34;/returns&#34;" target="url" />
          <zeebe:input source="={&#34;Content-Type&#34;:&#34;application/json&#34;}" target="headers" />
          <zeebe:input source="={order_id: if is defined(order_id) then order_id else null, order_item_id: if is defined(order_item_id) then order_item_id else null, return_quantity: if is defined(return_quantity) then return_quantity else null, return_reason: if is defined(return_reason) then return_reason else null, eligibility_status: if is defined(eligibility_status) then eligibility_status else null, agent_decision: if is defined(agent_decision) then agent_decision else null, agent_justification: if is defined(agent_justification) then agent_justification else null}" target="body" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultExpression" value="={return_id: response.body.return_id}" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_GW_Correction_Task_Enregistrement</bpmn:incoming>
      <bpmn:incoming>Flow_GW_Autorise_Task_Enregistrement</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_Enregistrement_GW_Fusion</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_RMA" name="Créer le dossier RMA">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="=&#34;http://host.docker.internal:8000&#34; + &#34;/returns&#34;" target="url" />
          <zeebe:input source="={&#34;Content-Type&#34;:&#34;application/json&#34;}" target="headers" />
          <zeebe:input source="={order_id: if is defined(order_id) then order_id else null, order_item_id: if is defined(order_item_id) then order_item_id else null, return_quantity: if is defined(return_quantity) then return_quantity else null, return_reason: if is defined(return_reason) then return_reason else null, requested_resolution: if is defined(requested_resolution) then requested_resolution else null, eligibility_status: if is defined(eligibility_status) then eligibility_status else null, ai_status: if is defined(ai_status) then ai_status else null, ai_suggestion: if is defined(ai_suggestion) then ai_suggestion else null, agent_decision: if is defined(agent_decision) then agent_decision else null, agent_justification: if is defined(agent_justification) then agent_justification else null}" target="body" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultExpression" value="={return_id: response.body.return_id}" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_GW_Autorise_Task_RMA</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_RMA_Task_Instructions</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Instructions" name="Envoyer les instructions de retour">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="=&#34;http://host.docker.internal:8000&#34; + &#34;/ai/generate-response&#34;" target="url" />
          <zeebe:input source="={&#34;Content-Type&#34;:&#34;application/json&#34;}" target="headers" />
          <zeebe:input source="={order_id: if is defined(order_id) then order_id else null, return_id: if is defined(return_id) then return_id else null, type: &#34;instructions&#34;}" target="body" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultExpression" value="={instructions_text: response.body.message}" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Task_RMA_Task_Instructions</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_Instructions_Task_Reception</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_Reception" name="Confirmer la réception du produit">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-reception-produit" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Task_Instructions_Task_Reception</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_Reception_Task_Inspection</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Evt_NonRecu" name="Produit non reçu sous 72 h" cancelActivity="false" attachedToRef="Task_Reception">
      <bpmn:outgoing>Flow_Evt_NonRecu_Task_RelanceClient</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT72H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:scriptTask id="Task_RelanceClient" name="Relancer le client">
      <bpmn:extensionElements>
        <zeebe:script expression="=if is defined(reminder_count) then reminder_count + 1 else 1" resultVariable="reminder_count" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Evt_NonRecu_Task_RelanceClient</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_RelanceClient_End_Relance</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="End_Relance" name="Relance envoyée">
      <bpmn:incoming>Flow_Task_RelanceClient_End_Relance</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_Inspection" name="Inspecter le produit">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-inspection-produit" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Task_Reception_Task_Inspection</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_Inspection_Task_Resolution</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Resolution" name="Valider la résolution finale">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-resolution-sav" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Task_Inspection_Task_Resolution</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_Resolution_Sub_Execution</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:subProcess id="Sub_Execution" name="Exécuter la résolution simulée">
      <bpmn:incoming>Flow_Task_Resolution_Sub_Execution</bpmn:incoming>
      <bpmn:outgoing>Flow_Sub_Execution_GW_Fusion</bpmn:outgoing>
      <bpmn:startEvent id="Start_Exec">
        <bpmn:outgoing>Flow_Start_Exec_Task_Exec</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="Task_Exec" name="Remboursement / échange / réparation simulé">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:http-json:1" />
          <zeebe:ioMapping>
            <zeebe:input source="noAuth" target="authentication.type" />
            <zeebe:input source="POST" target="method" />
            <zeebe:input source="=&#34;http://host.docker.internal:8000&#34; + &#34;/returns/&#34; + string(return_id) + &#34;/execute-resolution&#34;" target="url" />
            <zeebe:input source="={&#34;Content-Type&#34;:&#34;application/json&#34;}" target="headers" />
            <zeebe:input source="={final_resolution: if is defined(final_resolution) then final_resolution else null}" target="body" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="resultExpression" value="={resolution_status: response.body.resolution_status}" />
            <zeebe:header key="errorExpression" value="=if error != null then bpmnError(&#34;EXEC_FAILED&#34;, &#34;Échec de l&#39;exécution&#34;) else null" />
            <zeebe:header key="retryBackoff" value="PT0S" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_Start_Exec_Task_Exec</bpmn:incoming>
        <bpmn:outgoing>Flow_Task_Exec_End_Exec</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="End_Exec">
        <bpmn:incoming>Flow_Task_Exec_End_Exec</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_Start_Exec_Task_Exec" sourceRef="Start_Exec" targetRef="Task_Exec" />
      <bpmn:sequenceFlow id="Flow_Task_Exec_End_Exec" sourceRef="Task_Exec" targetRef="End_Exec" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="Evt_ExecErr" name="Exécution en échec" attachedToRef="Sub_Execution">
      <bpmn:outgoing>Flow_Evt_ExecErr_Task_Manuel</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrDef_Exec" errorRef="Error_Exec" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Task_Manuel" name="Traiter manuellement l&#39;échec d&#39;exécution">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-resolution-sav" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Evt_ExecErr_Task_Manuel</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_Manuel_GW_Fusion</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Fusion">
      <bpmn:incoming>Flow_Task_Enregistrement_GW_Fusion</bpmn:incoming>
      <bpmn:incoming>Flow_Sub_Execution_GW_Fusion</bpmn:incoming>
      <bpmn:incoming>Flow_Task_Manuel_GW_Fusion</bpmn:incoming>
      <bpmn:outgoing>Flow_GW_Fusion_Task_Reponse</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Reponse" name="Générer la réponse finale">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="=&#34;http://host.docker.internal:8000&#34; + &#34;/ai/generate-response&#34;" target="url" />
          <zeebe:input source="={&#34;Content-Type&#34;:&#34;application/json&#34;}" target="headers" />
          <zeebe:input source="={order_id: if is defined(order_id) then order_id else null, return_id: if is defined(return_id) then return_id else null, agent_decision: if is defined(agent_decision) then agent_decision else null, agent_justification: if is defined(agent_justification) then agent_justification else null, final_resolution: if is defined(final_resolution) then final_resolution else null, type: &#34;final&#34;}" target="body" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultExpression" value="={final_message: response.body.message}" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_GW_Fusion_Task_Reponse</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_Reponse_Task_Notifier</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Notifier" name="Notifier le client">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="=&#34;http://host.docker.internal:8000&#34; + &#34;/returns/&#34; + string(return_id) + &#34;/notify&#34;" target="url" />
          <zeebe:input source="={&#34;Content-Type&#34;:&#34;application/json&#34;}" target="headers" />
          <zeebe:input source="={final_message: if is defined(final_message) then final_message else null}" target="body" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultVariable" value="notification_result" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Task_Reponse_Task_Notifier</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_Notifier_Task_Cloture</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Cloture" name="Clôturer le dossier">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="=&#34;http://host.docker.internal:8000&#34; + &#34;/returns/&#34; + string(return_id) + &#34;/close&#34;" target="url" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>

      <zeebe:formDefinition formId="form-complement-information" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_GW_Trouve_Task_Correction</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_Correction_GW_Correction</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Correction" name="Correction fournie ?" default="Flow_GW_Correction_Task_Commande">
      <bpmn:incoming>Flow_Task_Correction_GW_Correction</bpmn:incoming>
      <bpmn:outgoing>Flow_GW_Correction_Task_Commande</bpmn:outgoing>
      <bpmn:outgoing>Flow_GW_Correction_Task_Enregistrement</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_GW_Correction_Task_Enregistrement" sourceRef="GW_Correction" targetRef="Task_Enregistrement" name="Abandon">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=is defined(correction_abandoned) and correction_abandoned = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

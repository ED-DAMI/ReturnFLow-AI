{
  "schemaVersion": 11,
  "type": "default",
  "id": "form-reanalyse-apres-inspection",
  "components": [
    {
      "type": "text",
      "id": "form-reanalyse-apres-inspection-title",
      "text": "# Réévaluation après inspection"
    },
    {
      "type": "text",
      "id": "form-reanalyse-apres-inspection-help",
      "text": "L’inspection a révélé un écart. Vérifiez les faits et consignez la réévaluation SAV. La décision de résolution est confirmée dans la tâche suivante. Terminez cette tâche après la revue."
    },
    {
      "label": "Résultat de l’inspection",
      "type": "textfield",
      "id": "form-reanalyse-apres-inspection-inspection_result",
      "key": "inspection_result",
      "readonly": true
    },
    {
      "label": "Écarts constatés",
      "type": "textarea",
      "id": "form-reanalyse-apres-inspection-inspection_differences",
      "key": "inspection_differences",
      "readonly": true
    },
    {
      "label": "Justification de la réévaluation",
      "type": "textarea",
      "id": "form-reanalyse-apres-inspection-reevaluation_reason",
      "key": "reevaluation_reason",
      "validate": {
        "required": true
      }
    }
  ],
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.52.0"
  }
}
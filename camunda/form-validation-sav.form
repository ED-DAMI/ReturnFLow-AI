{
  "schemaVersion": 11,
  "type": "default",
  "id": "form-validation-sav",
  "components": [
    {
      "type": "text",
      "id": "form-validation-sav-title",
      "text": "# Validation par l’agent SAV"
    },
    {
      "type": "text",
      "id": "form-validation-sav-help",
      "text": "L’IA et le RAG assistent l’analyse. Les règles déterministes évaluent l’éligibilité. L’agent SAV confirme l’éligibilité et décide si un retour physique est nécessaire; le mode de résolution sera confirmé dans la tâche suivante."
    },
    {
      "label": "Motif déclaré",
      "type": "textfield",
      "id": "form-validation-sav-return_reason",
      "key": "return_reason",
      "readonly": true
    },
    {
      "label": "Description du client",
      "type": "textarea",
      "id": "form-validation-sav-description",
      "key": "description",
      "readonly": true
    },
    {
      "label": "Catégorie détectée",
      "type": "textfield",
      "id": "form-validation-sav-category",
      "key": "category",
      "readonly": true
    },
    {
      "label": "Résumé de l’analyse",
      "type": "textarea",
      "id": "form-validation-sav-ai_summary",
      "key": "ai_summary",
      "readonly": true
    },
    {
      "label": "Confiance de l’analyse",
      "type": "number",
      "id": "form-validation-sav-confidence",
      "key": "confidence",
      "readonly": true
    },
    {
      "label": "Extraits de politique récupérés par le RAG",
      "type": "textarea",
      "id": "form-validation-sav-policyChunks",
      "key": "policyChunks",
      "readonly": true
    },
    {
      "label": "Sources de politique",
      "type": "textfield",
      "id": "form-validation-sav-sourceIds",
      "key": "sourceIds",
      "readonly": true
    },
    {
      "label": "Éligible selon les règles",
      "type": "checkbox",
      "id": "form-validation-sav-eligibility",
      "key": "eligibility",
      "readonly": true
    },
    {
      "label": "Justification des règles",
      "type": "textarea",
      "id": "form-validation-sav-eligibility_reason",
      "key": "eligibility_reason",
      "readonly": true
    },
    {
      "label": "Recommandation de l’assistant",
      "type": "textarea",
      "id": "form-validation-sav-recommendation",
      "key": "recommendation",
      "readonly": true
    },
    {
      "label": "Le produit doit être retourné physiquement",
      "type": "checkbox",
      "id": "form-validation-sav-returnRequired",
      "key": "returnRequired",
      "description": "Cette décision concerne uniquement le retour physique. Le mode de résolution est confirmé après cette étape.",
      "defaultValue": true
    },
    {
      "label": "Note de validation SAV",
      "type": "textarea",
      "id": "form-validation-sav-agent_note",
      "key": "agent_note",
      "validate": {
        "required": true
      }
    }
  ],
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.52.0"
  }
}
{
  "schemaVersion": 11,
  "type": "default",
  "id": "form-reception-produit",
  "components": [
    {
      "type": "text",
      "id": "form-reception-produit-title",
      "text": "# Réception du vêtement retourné"
    },
    {
      "type": "text",
      "id": "form-reception-produit-help",
      "text": "Réception simulée dans le cadre de l’étude académique."
    },
    {
      "label": "Article attendu",
      "type": "textfield",
      "id": "form-reception-produit-product_name",
      "key": "product_name",
      "readonly": true
    },
    {
      "label": "Quantité attendue",
      "type": "number",
      "id": "form-reception-produit-return_quantity",
      "key": "return_quantity",
      "readonly": true
    },
    {
      "label": "Date et heure de réception",
      "type": "datetime",
      "id": "form-reception-produit-received_at",
      "key": "received_at",
      "validate": {
        "required": true
      }
    },
    {
      "label": "Quantité reçue",
      "type": "number",
      "id": "form-reception-produit-received_quantity",
      "key": "received_quantity",
      "validate": {
        "required": true,
        "min": 0
      }
    },
    {
      "label": "État de l’emballage",
      "type": "select",
      "id": "form-reception-produit-package_condition",
      "key": "package_condition",
      "values": [
        {
          "label": "Intact",
          "value": "intact"
        },
        {
          "label": "Endommagé",
          "value": "damaged"
        },
        {
          "label": "Sans objet",
          "value": "not_applicable"
        }
      ],
      "validate": {
        "required": true
      }
    },
    {
      "label": "Commentaire de réception",
      "type": "textarea",
      "id": "form-reception-produit-reception_comment",
      "key": "reception_comment"
    }
  ],
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.52.0"
  }
}

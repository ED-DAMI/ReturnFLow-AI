{
  "schemaVersion": 11,
  "type": "default",
  "id": "form-resolution-sav",
  "components": [
    {
      "type": "text",
      "id": "form-resolution-sav_text_1",
      "text": "# Validation de la résolution finale (agent SAV)\nDécision prise **après réception et inspection**. Le remboursement, l'échange ou la réparation sont simulés."
    },
    {
      "label": "Identifiant RMA",
      "type": "textfield",
      "id": "form-resolution-sav_return_id_2",
      "key": "return_id",
      "readonly": true
    },
    {
      "label": "Résolution demandée par le client",
      "type": "textfield",
      "id": "form-resolution-sav_requested_resolution_3",
      "key": "requested_resolution",
      "readonly": true
    },
    {
      "label": "Résolution suggérée par l'IA",
      "type": "textfield",
      "id": "form-resolution-sav_ai_suggested_resolution_4",
      "key": "ai_suggested_resolution",
      "readonly": true,
      "conditional": {
        "hide": "=ai_status = \"fallback\""
      }
    },
    {
      "label": "Résultat de l'inspection",
      "type": "textfield",
      "id": "form-resolution-sav_inspection_result_5",
      "key": "inspection_result",
      "readonly": true
    },
    {
      "label": "État constaté",
      "type": "textfield",
      "id": "form-resolution-sav_inspection_condition_6",
      "key": "inspection_condition",
      "readonly": true
    },
    {
      "label": "Différences constatées",
      "type": "textarea",
      "id": "form-resolution-sav_inspection_differences_7",
      "key": "inspection_differences",
      "readonly": true
    },
    {
      "type": "text",
      "id": "form-resolution-sav_text_8",
      "text": "## Décision"
    },
    {
      "label": "Résolution finale",
      "type": "radio",
      "id": "form-resolution-sav_final_resolution_9",
      "key": "final_resolution",
      "validate": {
        "required": true
      },
      "values": [
        {
          "label": "Remboursement",
          "value": "refund"
        },
        {
          "label": "Échange",
          "value": "exchange"
        },
        {
          "label": "Réparation",
          "value": "repair"
        },
        {
          "label": "Refus motivé",
          "value": "motivated_refusal"
        }
      ]
    },
    {
      "label": "Montant du remboursement (fictif)",
      "type": "number",
      "id": "form-resolution-sav_refund_amount_10",
      "key": "refund_amount",
      "validate": {
        "required": true,
        "min": 0
      },
      "conditional": {
        "hide": "=final_resolution != \"refund\""
      },
      "decimalDigits": 2,
      "increment": "0.01"
    },
    {
      "label": "Justification",
      "type": "textarea",
      "id": "form-resolution-sav_resolution_justification_11",
      "key": "resolution_justification",
      "validate": {
        "required": true
      }
    }
  ],
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.5.0",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.22.0"
  }
}
{
  "schemaVersion": 11,
  "type": "default",
  "id": "form-resolution-sav",
  "components": [
    {
      "type": "text",
      "id": "form-resolution-sav-title",
      "text": "# Confirmer le mode de remboursement / traitement"
    },
    {
      "type": "text",
      "id": "form-resolution-sav-help",
      "text": "Les opérations sont simulées. Le choix alimente la passerelle de résolution du BPMN."
    },
    {
      "label": "Préférence indiquée par le client",
      "type": "textfield",
      "id": "form-resolution-sav-requested_resolution",
      "key": "requested_resolution",
      "readonly": true
    },
    {
      "label": "Résultat de l’inspection",
      "type": "textfield",
      "id": "form-resolution-sav-inspection_result",
      "key": "inspection_result",
      "readonly": true
    },
    {
      "label": "Mode de traitement",
      "type": "select",
      "id": "form-resolution-sav-refundMethod",
      "key": "refundMethod",
      "values": [
        {
          "label": "Remboursement portefeuille SHEIN",
          "value": "shein_wallet"
        },
        {
          "label": "Remboursement moyen initial",
          "value": "original_payment"
        },
        {
          "label": "Remboursement sans retour",
          "value": "returnless"
        },
        {
          "label": "Exception / revue manuelle",
          "value": "manual"
        }
      ],
      "validate": {
        "required": true
      }
    },
    {
      "label": "Montant fictif du remboursement",
      "type": "number",
      "id": "form-resolution-sav-refund_amount",
      "key": "refund_amount",
      "validate": {
        "min": 0
      }
    },
    {
      "label": "Justification",
      "type": "textarea",
      "id": "form-resolution-sav-resolution_justification",
      "key": "resolution_justification",
      "validate": {
        "required": true
      }
    }
  ],
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.52.0"
  }
}

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=app_db
DB_USER=postgres
DB_PASSWORD=replace-with-a-local-password

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
RAG_EMBEDDING_LOCAL_ONLY=false
RAG_CHUNK_SIZE=420
RAG_CHUNK_OVERLAP=60
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.30
RETURN_WINDOW_DAYS=30

# Camunda 8 Orchestration Cluster REST API (local default; SaaS can use region + cluster ID)
CAMUNDA_REST_URL=http://localhost:8080/v2
CAMUNDA_REGION=
CAMUNDA_CLUSTER_ID=
CAMUNDA_OAUTH_URL=https://login.cloud.camunda.io/oauth/token
CAMUNDA_TOKEN_AUDIENCE=
CAMUNDA_CLIENT_ID=
CAMUNDA_CLIENT_SECRET=
# For a local engine with explicit bearer auth, use CAMUNDA_ACCESS_TOKEN instead.
CAMUNDA_ACCESS_TOKEN=
CAMUNDA_BASIC_USERNAME=demo
CAMUNDA_BASIC_PASSWORD=demo
CAMUNDA_JOB_TYPE=shein-agent
CAMUNDA_WORKER_ID=returnflow-israe-worker
CAMUNDA_JOB_TIMEOUT_MS=300000

# Optional fictional order fixture for a classroom demo; never connects to SHEIN.
DEMO_ORDER_LOOKUP=false
